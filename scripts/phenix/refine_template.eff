data_manager {
  miller_array {
    file = "$MTZFILE"
    labels {
      name = "FP,SIGFP"
      array_type = unknown *amplitude bool complex hendrickson_lattman \
                   integer intensity nonsense
    }
    labels {
      name = "FREE"
      array_type = unknown amplitude bool complex hendrickson_lattman \
                   *integer intensity nonsense
    }
    user_selected_labels = "FP,SIGFP"
    user_selected_labels = "FREE"
  }
  fmodel {
    xray_data {
      r_free_flags {
        test_flag_value = 0
      }
    }
  }
}
refinement {
  refine {
    strategy = individual_sites individual_sites_real_space *rigid_body \
               *individual_adp group_adp tls *occupancies group_anomalous den
  }
  main {
    nproc = "$NPROC"
    ordered_solvent = True
    number_of_macro_cycles = $NUMCYCLE
  }
  ordered_solvent {
    mode = second_half filter_only every_macro_cycle \
           *every_macro_cycle_after_first
    primary_map_cutoff = $MAPCUTOFF
  }
  output {
    write_def_file = False
  }
}
output {
  overwrite = True
}
